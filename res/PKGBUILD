pkgname=rustdesk-direct-ip-remote-support
pkgver=1.4.9
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'pam' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/rustdesk-direct-ip-remote-support/rustdesk usr/bin/rustdesk && popd
  # Pre-bake config.toml with the matching role (set ROLE=local or ROLE=remote before calling
  # makepkg) so this package never requires a manual `rustdesk --setup-local`/`--setup-remote`
  # step - mirrors the Windows Local/Remote MSI split. Falls back to bundling both as loose
  # sample files if ROLE isn't set (e.g. a manual `makepkg -f` outside CI).
  if [[ "${ROLE}" == "local" || "${ROLE}" == "remote" ]]; then
    install -Dm 644 $HBB/configs/${ROLE}.toml "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support/config.toml"
  else
    install -Dm 644 $HBB/configs/local.toml "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support/local.toml"
    install -Dm 644 $HBB/configs/remote.toml "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support/remote.toml"
  fi
  install -Dm 644 $HBB/res/rustdesk.service -t "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support/files"
  install -Dm 644 $HBB/res/rustdesk.desktop -t "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support/files"
  install -Dm 644 $HBB/res/rustdesk-link.desktop -t "${pkgdir}/usr/share/rustdesk-direct-ip-remote-support/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/rustdesk-direct-ip-remote-support.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/rustdesk-direct-ip-remote-support.svg"
}
