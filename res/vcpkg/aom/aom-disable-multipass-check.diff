 # Terminates generation if nasm found in PATH does not meet requirements.
 # Currently checks only for presence of required object formats and support for
 # the -Ox argument (multipass optimization).
 function(test_nasm)
+  # Workaround for NASM 3.01 compatibility (vcpkg default on Windows).
+  # Multipass is a performance optimization, not a hard requirement.
+  # This allows aom to build without requiring NASM >= 2.15.
+  # See: https://github.com/aomedia/aom/issues
+  return()
+
   execute_process(COMMAND ${CMAKE_ASM_NASM_COMPILER} -hf
                   OUTPUT_VARIABLE nasm_helptext)

