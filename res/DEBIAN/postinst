#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/rustdesk-direct-ip-remote-support/rustdesk /usr/bin/rustdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/rustdesk-direct-ip-remote-support.service ]; then
			rm /etc/systemd/system/rustdesk-direct-ip-remote-support.service /usr/lib/systemd/system/rustdesk-direct-ip-remote-support.service /usr/lib/systemd/user/rustdesk-direct-ip-remote-support.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/rustdesk-direct-ip-remote-support/files/systemd/rustdesk-direct-ip-remote-support.service /usr/lib/systemd/system/rustdesk-direct-ip-remote-support.service
		# try fix error in Ubuntu 18.04
		# Failed to reload rustdesk-direct-ip-remote-support.service: Unit rustdesk-direct-ip-remote-support.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/rustdesk-direct-ip-remote-support.service:10: Executable path is not absolute: pkill -f "rustdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/rustdesk-direct-ip-remote-support.service
		fi
		systemctl daemon-reload

		# Fork config: only auto-enable/start the background service for a "remote" (inbound)
		# install - a "local" (outbound-only) install has no legitimate use for it (see
		# core_main.rs's is_outgoing_only() gate on this same service's --service/--server
		# entry points). This is a two-variant package build (build.py::build_flutter_deb(),
		# mirroring the Windows Local/Remote MSI split): each variant's config.toml is pre-baked
		# at build time with the matching role, so this check is fully automatic - no manual
		# `rustdesk --setup-local`/`--setup-remote` step is ever required. The "config.toml
		# missing" fallback below is just a safety net (e.g. a corrupted install), not the normal
		# path.
		CONFIG_FILE=/usr/share/rustdesk-direct-ip-remote-support/config.toml
		ROLE=""
		if [ -f "$CONFIG_FILE" ]; then
			ROLE=$(grep -E '^[[:space:]]*role[[:space:]]*=' "$CONFIG_FILE" | head -1 | sed -E 's/^[[:space:]]*role[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/')
		fi
		if [ "$ROLE" = "remote" ]; then
			systemctl enable rustdesk-direct-ip-remote-support
			systemctl start rustdesk-direct-ip-remote-support
		elif [ "$ROLE" = "local" ]; then
			echo "rustdesk-direct-ip-remote-support: local (outbound-only) install - background service not enabled/started."
		else
			echo "rustdesk-direct-ip-remote-support: config.toml missing or has no role - this should not happen on a normal install. Service installed but not enabled/started."
			echo "Run 'rustdesk --setup-remote' then 'systemctl enable --now rustdesk-direct-ip-remote-support' to accept inbound connections."
		fi
	fi
fi
